# 2. CONEXIÓN DIRECTA A POSTGRESQL DE SUPABASE (Opcional para Prisma ORM en Dokploy)
# Obtén esto en Supabase -> Project Settings -> Database -> Connection string (URI)
# Usa el modo Transaction (puerto 6543) o Session (puerto 5432):
DATABASE_URL="postgresql://postgres.[tu-ref]:[tu-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[tu-ref]:[tu-password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# 3. MOTOR DE INTELIGENCIA ARTIFICIAL LOCAL (Coach y Visión Nutricional)
# Si corres Ollama en Dokploy en la misma red de docker-compose:
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_TEXT_MODEL="llama3.2"
OLLAMA_VISION_MODEL="llama3.2-vision"

# 4. CONFIGURACIÓN GENERAL DE LA APLICACIÓN
NEXT_PUBLIC_APP_URL="https://mygymbrou.tudominio.com"
NODE_ENV="production"
